{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    },
    {
      "src": "python-api/python-extract/index.py",
      "use": "@vercel/python",
      "config": { "maxDuration": 30, "memory": 512 }
    }
  ],
  "rewrites": [
    {
      "source": "/api/python-extract",
      "destination": "/python-api/python-extract"
    }
  ]
}
