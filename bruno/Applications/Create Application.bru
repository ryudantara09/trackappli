meta {
  name: Create Application
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/applications
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "company": "Tech Corp",
    "position": "Software Engineer",
    "status": "APPLIED",
    "applicationDate": "2024-01-15",
    "positionUrl": "https://example.com/job",
    "location": "Remote",
    "salary": "100000-150000",
    "notes": "Great opportunity"
  }
}
