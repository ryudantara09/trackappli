meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "test@test.tt",
    "password": "00000000"
  }
}

docs {
  # Login
  
  Use this to get an access token for testing authenticated endpoints.
  
  1. Create a user in Supabase dashboard first
  2. Update the email/password in the request body
  3. Send the request
  4. Copy the `access_token` from the response
  5. Use it in other requests by adding a header:
     `Authorization: Bearer <access_token>`
}
