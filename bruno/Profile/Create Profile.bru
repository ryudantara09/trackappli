meta {
  name: Create Profile
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

body:json {
  {
    "first_name": "asdasd",
    "last_name": "dsadsa",
    "email": "asd.dsa@example.com",
    "phone": "+1234567890",
    "location": "San Francisco, CA",
    "summary": "Experienced software engineer with 5+ years in full-stack development"
  }
}
