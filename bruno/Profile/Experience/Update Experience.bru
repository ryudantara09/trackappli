meta {
  name: Update Experience
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/profile/experience/:id
  body: json
  auth: bearer
}

auth:bearer {
  token: {{authToken}}
}

params:path {
  id: 1
}

body:json {
  {
    "position": "Lead Software Engineer",
    "description": "Led team of 5 engineers"
  }
}
